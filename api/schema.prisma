// This file is automatically generated by Keystone, do not modify it manually.
// Modify your Keystone config when you want to change this.

datasource sqlite {
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
  provider          = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model Survey {
  id          String     @id @default(cuid())
  title       String     @default("")
  description String     @default("")
  questions   Question[] @relation("Question_survey")
  createdAt   DateTime?  @default(now())
}

model Question {
  id        String     @id @default(cuid())
  text      String     @default("")
  survey    Survey?    @relation("Question_survey", fields: [surveyId], references: [id])
  surveyId  String?    @map("survey")
  responses Response[] @relation("Response_question")

  @@index([surveyId])
}

model Response {
  id         String    @id @default(cuid())
  question   Question? @relation("Response_question", fields: [questionId], references: [id])
  questionId String?   @map("question")
  rating     Int
  userName   String    @default("")
  createdAt  DateTime? @default(now())

  @@index([questionId])
}
